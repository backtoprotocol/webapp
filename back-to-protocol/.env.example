# Create a project at https://www.sanity.io/manage, then add its values here.
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only. Never expose this as a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=""

# Web auth uses the same Firebase project as the mobile app.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Address opened by the support request form.
NEXT_PUBLIC_SUPPORT_EMAIL="support@backtoprotocol.com"

# Only needed later if you enable private datasets, drafts, or Visual Editing.
# SANITY_API_READ_TOKEN=""
